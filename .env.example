# AgentDock 自身认证。公网 Tunnel 下必须设置。
AGENTDOCK_AUTH_TOKEN=replace-with-a-random-token

# Named Tunnel 使用固定 HTTPS Origin；Quick Tunnel 留空。
AGENTDOCK_SERVER_URL=https://agent.example.com

# 仅 Named Tunnel 需要。不要提交真实值。
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# 可选：宿主机发布端口，默认与容器内一致（8765）。
# AGENTDOCK_PUBLISH_PORT=8765

# 可选：浏览器自动化镜像。
# AGENTDOCK_IMAGE=ghcr.io/uvwt/agentdock:browser-latest
# AGENTDOCK_BROWSER_ENABLED=true
