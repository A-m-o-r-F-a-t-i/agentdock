#!/data/data/com.termux/files/usr/bin/sh
set -eu
umask 077

# Fixed RUN_COMMAND entry for the external Termux app. Android passes no shell
# command fragments: only five validated positional fields and bounded JSON on stdin.
OPERATION="${1:-}"
OPERATION_ID="${2:-}"
REQUEST_ID="${3:-}"
NONCE="${4:-}"
PAYLOAD_PATH="${5:-}"

if [ "${AGENTDOCK_WORKBENCH_TEST_MODE:-0}" = 1 ]; then
  HOME_ROOT="${AGENTDOCK_WORKBENCH_TEST_HOME:?test home required}"
else
  HOME_ROOT="$HOME"
fi
STATE="$HOME_ROOT/.agentdock-workbench"
INBOX="$STATE/inbox"
LOCKS="$STATE/locks"
TRUST="$STATE/trust"
LOGS="$STATE/logs"
PAYLOAD=""
mkdir -p "$INBOX" "$LOCKS" "$TRUST" "$LOGS"

json_result() {
  status="$1"; message="$2"; phase="${3:-$status}"; credential="${4:-}"
  if command -v jq >/dev/null 2>&1; then
    if [ -n "$credential" ]; then
      jq -cn --arg op "$OPERATION" --arg oid "$OPERATION_ID" --arg rid "$REQUEST_ID" --arg nonce "$NONCE" \
        --arg status "$status" --arg phase "$phase" --arg message "$message" --arg token "$credential" \
        '{schema_version:1,operation:$op,operation_id:$oid,request_id:$rid,nonce:$nonce,status:$status,phase:$phase,message:$message,credential:{type:"bearer",value:$token}}'
    else
      jq -cn --arg op "$OPERATION" --arg oid "$OPERATION_ID" --arg rid "$REQUEST_ID" --arg nonce "$NONCE" \
        --arg status "$status" --arg phase "$phase" --arg message "$message" \
        '{schema_version:1,operation:$op,operation_id:$oid,request_id:$rid,nonce:$nonce,status:$status,phase:$phase,message:$message}'
    fi
  else
    # jq is mandatory after bootstrap. This fallback is deliberately static and
    # never interpolates untrusted message text into JSON.
    printf '{"schema_version":1,"operation":"%s","operation_id":"%s","request_id":"%s","nonce":"%s","status":"requires_user_action","phase":"blocked","message":"Install jq in Termux"}\n' \
      "$OPERATION" "$OPERATION_ID" "$REQUEST_ID" "$NONCE"
  fi
}

fail() {
  message="$1"; code="${2:-failed}"
  json_result "$code" "$message" "failed"
  exit 1
}

valid_id() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_-]{1,96}$'; }
valid_nonce() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_-]{20,128}$'; }
case "$OPERATION" in
  probe|bootstrap|install|adopt|status|start|stop|restart|repair|guardian_check|update|rollback|export_diagnostics) ;;
  *) fail "Unsupported bridge operation" "invalid_request" ;;
esac
valid_id "$OPERATION_ID" || fail "Invalid operation id" "invalid_request"
valid_id "$REQUEST_ID" || fail "Invalid request id" "invalid_request"
valid_nonce "$NONCE" || fail "Invalid nonce" "invalid_request"
[ "$PAYLOAD_PATH" = "-" ] || fail "Only bounded stdin payloads are accepted" "invalid_request"

PAYLOAD="$INBOX/$REQUEST_ID.json"
cleanup() { rm -f "$PAYLOAD"; }
trap cleanup EXIT HUP INT TERM
# Read one byte beyond the contract limit so oversize payloads cannot be silently truncated.
dd bs=65537 count=1 of="$PAYLOAD" 2>/dev/null || true
size="$(wc -c <"$PAYLOAD" | tr -d ' ')"
[ "$size" -le 65536 ] || fail "Payload exceeds 65536 bytes" "invalid_request"
if [ "$size" -eq 0 ]; then printf '{}\n' >"$PAYLOAD"; fi
if command -v jq >/dev/null 2>&1; then
  jq -e . "$PAYLOAD" >/dev/null 2>&1 || fail "Payload is not valid JSON" "invalid_request"
  [ "$(jq -r '.schema_version // 0' "$PAYLOAD")" = 1 ] || fail "Unsupported payload schema" "invalid_request"
  [ "$(jq -r '.operation_id // ""' "$PAYLOAD")" = "$OPERATION_ID" ] || fail "Payload operation binding mismatch" "invalid_request"
  [ "$(jq -r '.request_id // ""' "$PAYLOAD")" = "$REQUEST_ID" ] || fail "Payload request binding mismatch" "invalid_request"
  [ "$(jq -r '.nonce // ""' "$PAYLOAD")" = "$NONCE" ] || fail "Payload nonce mismatch" "invalid_request"
  [ "$(jq -r '.operation // ""' "$PAYLOAD")" = "$OPERATION" ] || fail "Payload operation mismatch" "invalid_request"
fi

exec 9>"$LOCKS/bridge.lock"
if command -v flock >/dev/null 2>&1; then
  flock -w 30 9 || fail "Another node operation is still running" "busy"
fi

managed_root() {
  if [ -f "$STATE/adopted-root" ]; then
    root="$(cat "$STATE/adopted-root")"
    case "$root" in "$HOME_ROOT"/*) printf '%s' "$root"; return ;; esac
  fi
  printf '%s' "$STATE/node"
}
ROOT="$(managed_root)"
VERSIONS="$ROOT/versions"
CURRENT="$ROOT/current"
PREVIOUS="$ROOT/previous"
RUNTIME="$ROOT/runtime"
DATA="$ROOT/data"
WORKSPACE="$ROOT/workspace"
PIDFILE="$ROOT/core.pid"
DESIRED="$ROOT/desired-state"
TOKEN_FILE="$ROOT/auth-token"
mkdir -p "$VERSIONS" "$RUNTIME" "$DATA" "$WORKSPACE" "$ROOT/logs"

have_termux_dependencies() {
  command -v proot-distro >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && command -v sha256sum >/dev/null 2>&1
}
debian_installed() {
  if [ "${AGENTDOCK_WORKBENCH_TEST_MODE:-0}" = 1 ]; then return 0; fi
  proot-distro list 2>/dev/null | grep -Eq 'debian.*\(installed\)|debian.*installed'
}
run_debian() {
  if [ "${AGENTDOCK_WORKBENCH_TEST_MODE:-0}" = 1 ]; then
    /bin/sh -c "$1"
  else
    proot-distro login debian --bind "$ROOT:/opt/agentdock-workbench" -- /bin/sh -lc "$1"
  fi
}
ensure_token() {
  if [ ! -s "$TOKEN_FILE" ]; then
    if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32 >"$TOKEN_FILE"
    else od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$TOKEN_FILE"; fi
    chmod 600 "$TOKEN_FILE"
  fi
}
health_ok() { curl -fsS --max-time 3 http://127.0.0.1:8765/healthz >/dev/null 2>&1; }
pid_alive() {
  [ -s "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  valid_id "$pid" || return 1
  kill -0 "$pid" 2>/dev/null
}
core_version() {
  [ -x "$CURRENT/bin/agentdock" ] || { printf 'not-installed'; return; }
  run_debian '/opt/agentdock-workbench/current/bin/agentdock version --json 2>/dev/null' | jq -r '.version // "unknown"' 2>/dev/null || printf 'unknown'
}
start_core() {
  [ -x "$CURRENT/bin/agentdock" ] || return 2
  if health_ok; then return 0; fi
  if pid_alive; then
    pid="$(cat "$PIDFILE")"; kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  ensure_token
  printf 'running\n' >"$DESIRED"
  token="$(cat "$TOKEN_FILE")"
  command="export AGENTDOCK_HOME=/opt/agentdock-workbench/data; export AGENTDOCK_DEFAULT_DIR=/opt/agentdock-workbench/workspace; export AGENTDOCK_HOST=127.0.0.1; export AGENTDOCK_PORT=8765; export AGENTDOCK_AUTH_TOKEN='$token'; export AGENTDOCK_MCP_APPS_ENABLED=false; exec /opt/agentdock-workbench/current/bin/agentdock"
  if [ "${AGENTDOCK_WORKBENCH_TEST_MODE:-0}" = 1 ]; then
    /bin/sh -c 'while :; do sleep 60; done' >"$ROOT/logs/core.log" 2>&1 &
  else
    setsid proot-distro login debian --bind "$ROOT:/opt/agentdock-workbench" -- /bin/sh -lc "$command" >"$ROOT/logs/core.log" 2>&1 &
  fi
  pid=$!
  printf '%s\n' "$pid" >"$PIDFILE"
  attempts=0
  while [ "$attempts" -lt 20 ]; do
    if health_ok; then return 0; fi
    kill -0 "$pid" 2>/dev/null || break
    attempts=$((attempts + 1)); sleep 1
  done
  kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  rm -f "$PIDFILE"
  return 1
}
stop_core() {
  # Desired state is persisted before any process signal, preventing an enabled
  # guardian from interpreting an explicit stop as a crash.
  printf 'stopped\n' >"$DESIRED"
  if pid_alive; then
    pid="$(cat "$PIDFILE")"
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    attempts=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 10 ]; do attempts=$((attempts + 1)); sleep 1; done
    kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
}
require_signed_manifest() {
  key="$TRUST/release-ed25519-public.pem"
  [ -s "$key" ] || return 75
  manifest_url="$(jq -r '.manifest_url // ""' "$PAYLOAD")"
  signature_url="$(jq -r '.manifest_signature_url // ""' "$PAYLOAD")"
  case "$manifest_url" in https://*) ;; *) return 76 ;; esac
  case "$signature_url" in https://*) ;; *) return 76 ;; esac
  manifest="$ROOT/manifest.$REQUEST_ID.json"; signature="$manifest.sig.$REQUEST_ID"
  curl -fsSL --retry 3 --proto '=https' --tlsv1.2 "$manifest_url" -o "$manifest" || return 77
  curl -fsSL --retry 3 --proto '=https' --tlsv1.2 "$signature_url" -o "$signature" || return 77
  openssl pkeyutl -verify -pubin -inkey "$key" -rawin -in "$manifest" -sigfile "$signature" >/dev/null 2>&1 || return 78
  jq -e '.schema_version == 1 and .platform == "linux" and .arch == "arm64" and (.version|type=="string") and (.asset_url|type=="string") and (.sha256|test("^[0-9a-f]{64}$"))' "$manifest" >/dev/null || return 79
  printf '%s' "$manifest"
}
install_from_manifest() {
  manifest="$(require_signed_manifest)" || return $?
  version="$(jq -r '.version' "$manifest")"
  asset_url="$(jq -r '.asset_url' "$manifest")"
  expected="$(jq -r '.sha256' "$manifest")"
  case "$asset_url" in https://*) ;; *) return 80 ;; esac
  archive="$ROOT/agentdock.$REQUEST_ID.tar.gz"; stage="$VERSIONS/.stage-$REQUEST_ID"
  rm -rf "$stage"; mkdir -p "$stage"
  curl -fsSL --retry 3 --proto '=https' --tlsv1.2 "$asset_url" -o "$archive" || return 81
  actual="$(sha256sum "$archive" | awk '{print $1}')"
  [ "$actual" = "$expected" ] || return 82
  tar -xzf "$archive" -C "$stage" || return 83
  [ -x "$stage/bin/agentdock" ] || return 84
  reported="$(if [ "${AGENTDOCK_WORKBENCH_TEST_MODE:-0}" = 1 ]; then printf '%s' "$version"; else run_debian "/opt/agentdock-workbench/versions/.stage-$REQUEST_ID/bin/agentdock version --json" | jq -r '.version'; fi)"
  [ "$reported" = "$version" ] || return 85
  target="$VERSIONS/$version"
  rm -rf "$target"; mv "$stage" "$target"
  if [ -L "$CURRENT" ]; then
    old="$(readlink "$CURRENT")"
    ln -sfn "$old" "$PREVIOUS"
  fi
  ln -sfn "$target" "$CURRENT"
  rm -f "$archive" "$manifest" "$manifest.sig.$REQUEST_ID"
  # Retain current plus one rollback generation.
  keep_current="$(readlink "$CURRENT" 2>/dev/null || true)"; keep_previous="$(readlink "$PREVIOUS" 2>/dev/null || true)"
  for directory in "$VERSIONS"/*; do
    [ -d "$directory" ] || continue
    [ "$directory" = "$keep_current" ] || [ "$directory" = "$keep_previous" ] || rm -rf "$directory"
  done
  return 0
}

case "$OPERATION" in
  probe)
    if ! have_termux_dependencies; then json_result "requires_user_action" "Termux 缺少 proot-distro/curl/jq/coreutils" "blocked"; exit 0; fi
    if ! debian_installed; then json_result "requires_user_action" "Debian PRoot 尚未安装" "blocked"; exit 0; fi
    ensure_token
    if health_ok; then json_result "healthy" "Core $(core_version) 正常" "complete" "$(cat "$TOKEN_FILE")"
    elif [ -x "$CURRENT/bin/agentdock" ]; then json_result "stopped" "已发现受管 Core $(core_version)，当前未运行" "complete" "$(cat "$TOKEN_FILE")"
    else json_result "requires_user_action" "Termux 与 Debian 已就绪；等待受信发布清单安装 Core" "blocked" "$(cat "$TOKEN_FILE")"; fi
    ;;
  bootstrap)
    have_termux_dependencies || { json_result "requires_user_action" "请先运行随 APK 提供的 Termux bootstrap 脚本" "blocked"; exit 0; }
    debian_installed || { json_result "requires_user_action" "请在 Termux 执行 proot-distro install debian" "blocked"; exit 0; }
    ensure_token
    run_debian 'command -v curl >/dev/null && command -v tar >/dev/null && command -v jq >/dev/null' >/dev/null 2>&1 || {
      json_result "requires_user_action" "Debian 缺少 ca-certificates/curl/tar/jq，请运行 bootstrap 修复" "blocked"; exit 0;
    }
    [ -s "$TRUST/release-ed25519-public.pem" ] || { json_result "pending_manifest" "节点已初始化；等待 WB05 提供正式发布签名公钥与清单" "blocked" "$(cat "$TOKEN_FILE")"; exit 0; }
    json_result "ok" "节点初始化完成" "complete" "$(cat "$TOKEN_FILE")"
    ;;
  install|update)
    [ -s "$TRUST/release-ed25519-public.pem" ] || { json_result "pending_manifest" "缺少正式发布签名公钥；未下载或安装任何 Core" "blocked"; exit 0; }
    stop_was_running=false; health_ok && stop_was_running=true
    if install_from_manifest; then rc=0; else rc=$?; fi
    case "$rc" in
      0) ;;
      75) json_result "pending_manifest" "缺少正式发布签名公钥" "blocked"; exit 0 ;;
      76|77|78|79) fail "发布清单下载、格式或签名验证失败" "trust_failed" ;;
      *) fail "ARM64 载荷下载、SHA-256 或版本验证失败" "verification_failed" ;;
    esac
    if [ "$stop_was_running" = true ]; then
      stop_core; if ! start_core; then
        if [ -L "$PREVIOUS" ]; then ln -sfn "$(readlink "$PREVIOUS")" "$CURRENT"; start_core || true; fi
        fail "新版本健康检查失败，已尝试回退" "health_failed"
      fi
    fi
    json_result "${OPERATION}d" "Core $(core_version) 已验证并原子切换" "complete"
    ;;
  adopt)
    requested="$(jq -r '.existing_root // ""' "$PAYLOAD")"
    confirmed="$(jq -r '.confirm_adopt // false' "$PAYLOAD")"
    [ "$confirmed" = true ] || fail "Adoption requires explicit confirmation" "invalid_request"
    case "$requested" in "$HOME_ROOT"/*) ;; *) fail "Existing root must remain under Termux home" "invalid_request" ;; esac
    [ -x "$requested/current/bin/agentdock" ] || fail "Existing node layout is not compatible" "invalid_request"
    printf '%s\n' "$requested" >"$STATE/adopted-root"
    chmod 600 "$STATE/adopted-root"
    json_result "adopted" "现有节点已显式纳入管理；未修改其版本或配置" "complete"
    ;;
  status)
    desired="$(cat "$DESIRED" 2>/dev/null || printf stopped)"
    if health_ok; then json_result "running" "Core $(core_version) 正常；desired=$desired" "complete"
    elif pid_alive; then json_result "failed" "Core 进程存在但健康检查失败；desired=$desired" "degraded"
    else json_result "stopped" "Core 未运行；desired=$desired" "complete"; fi
    ;;
  start)
    start_core || fail "Core 启动或健康检查失败" "health_failed"
    json_result "running" "Core $(core_version) 已启动" "complete"
    ;;
  stop)
    stop_core
    json_result "stopped" "Core 已停止；守护暂停状态不受影响" "complete"
    ;;
  restart)
    stop_core; start_core || fail "Core 重启健康检查失败" "health_failed"
    json_result "running" "Core $(core_version) 已重启" "complete"
    ;;
  repair|guardian_check)
    desired="$(cat "$DESIRED" 2>/dev/null || printf stopped)"
    if [ "$desired" != running ]; then json_result "stopped" "用户期望状态为 stopped，未自动启动" "complete"; exit 0; fi
    if health_ok; then json_result "healthy" "Core $(core_version) 正常" "complete"; exit 0; fi
    start_core || fail "受限恢复失败；未执行更新或版本替换" "health_failed"
    json_result "healthy" "Core 已按 desired=running 恢复" "complete"
    ;;
  rollback)
    [ -L "$PREVIOUS" ] || { json_result "requires_user_action" "没有可回退版本" "blocked"; exit 0; }
    old_current="$(readlink "$CURRENT")"; rollback="$(readlink "$PREVIOUS")"
    stop_core; ln -sfn "$rollback" "$CURRENT"; ln -sfn "$old_current" "$PREVIOUS"
    start_core || { ln -sfn "$old_current" "$CURRENT"; start_core || true; fail "回退版本未通过健康检查，已恢复原指针" "health_failed"; }
    json_result "rolled_back" "已回退到 Core $(core_version)" "complete"
    ;;
  export_diagnostics)
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"; out="$STATE/agentdock-diagnostics-$stamp.tar.gz"; temp="$STATE/diagnostics-$REQUEST_ID"
    rm -rf "$temp"; mkdir -p "$temp"
    { printf 'desired='; cat "$DESIRED" 2>/dev/null || printf stopped; printf '\nversion=%s\n' "$(core_version)"; printf 'health='; health_ok && printf healthy || printf unavailable; printf '\n'; } >"$temp/status.txt"
    tail -n 1000 "$ROOT/logs/core.log" 2>/dev/null | sed -E 's/(Bearer |token[=: ]+)[A-Za-z0-9._-]+/\1<redacted>/Ig' >"$temp/core.log" || true
    tar -czf "$out" -C "$temp" .; rm -rf "$temp"
    json_result "ok" "诊断包已写入 Termux 私有路径：$out" "complete"
    ;;
esac
