<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>agentdock-tray</AssemblyName>
    <AssemblyTitle>AgentDock Workbench</AssemblyTitle>
    <Product>AgentDock Workbench</Product>
    <Version>1.1.8</Version>
    <Description>AgentDock Workbench Control Panel</Description>
    <RootNamespace>AgentDock.ControlPanel</RootNamespace>
    <ApplicationIcon>..\..\..\packaging\windows\assets\agentdock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentDock.ControlPanel.LayoutTests" />
    <InternalsVisibleTo Include="AgentDock.ControlPanel.NativeTests" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
