<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>agentdock-tray</AssemblyName>
    <AssemblyTitle>AgentDock Workbench</AssemblyTitle>
    <Product>AgentDock Workbench</Product>
    <Version>1.1.7</Version>
    <Description>AgentDock Workbench Control Panel</Description>
    <RootNamespace>AgentDock.ControlPanel</RootNamespace>
    <ApplicationIcon>..\..\..\packaging\windows\assets\agentdock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AgentDockRuntimeSplit Condition="'$(AgentDockRuntimeSplit)' == ''">false</AgentDockRuntimeSplit>
    <PublishSingleFile Condition="'$(AgentDockRuntimeSplit)' != 'true'">true</PublishSingleFile>
    <SelfContained Condition="'$(AgentDockRuntimeSplit)' != 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(AgentDockRuntimeSplit)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AgentDockRuntimeSplit)' == 'true'">
    <!-- Candidate-only framework-dependent layout. Existing release commands
         retain the self-contained single-file defaults above. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentDock.ControlPanel.LayoutTests" />
    <InternalsVisibleTo Include="AgentDock.ControlPanel.NativeTests" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
