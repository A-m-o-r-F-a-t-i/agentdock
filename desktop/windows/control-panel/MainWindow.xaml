<Window x:Class="AgentDock.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentDock.ControlPanel"
        Title="{local:Loc MainWindowTitle}"
        Width="860" Height="780" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="AgentDock" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{local:Loc WindowsControlPanel}" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
          <TextBlock x:Name="HeaderStatusText" Text="{local:Loc LoadingStatus}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="18">
      <TabItem Header="{local:Loc Overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc RuntimeStatus}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Service}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="ServiceStatusText" Grid.Column="1" Text="{local:Loc Unknown}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc HealthCheck}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="HealthStatusText" Grid.Row="1" Grid.Column="1" Text="{local:Loc Unknown}" Margin="0,0,0,10" />
                <TextBlock Text="Nexus" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="NexusStatusText" Grid.Row="2" Grid.Column="1" Text="{local:Loc NotConfigured}" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc Version}" Grid.Row="3" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Text="{local:Loc Unknown}" />
                <StackPanel Grid.Column="2" Grid.RowSpan="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{local:Loc Start}" Click="StartButton_Click" />
                  <Button Content="{local:Loc Stop}" Click="StopButton_Click" />
                  <Button Content="{local:Loc Restart}" Click="RestartButton_Click" />
                  <Button x:Name="UpdateButton" Content="{local:Loc Update}" Click="UpdateButton_Click" />
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc TaskActivityCenter}">
              <DockPanel><Button DockPanel.Dock="Left" Content="{local:Loc TaskActivityCenter}" Click="OpenActivityCenter_Click" />
                <TextBlock x:Name="ActivitySummaryText" Text="{local:Loc NotChecked}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </GroupBox>
            <GroupBox Header="{local:Loc ConnectionAddresses}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc LocalMCP}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="LocalMcpTextBox" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc PublicMCP}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="PublicMcpTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,10" />
                <Button Grid.Row="1" Grid.Column="2" Content="{local:Loc Test}" Click="TestPublicButton_Click" />
                <TextBlock Text="{local:Loc PublicCheck}" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="PublicTestStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{local:Loc NotChecked}" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc AccessCredentials}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Bearer Token" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="BearerTokenTextBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,10" />
                <Button x:Name="ToggleBearerButton" Grid.Column="2" Content="{local:Loc Show}" Click="ToggleBearerButton_Click" />
                <TextBlock Text="{local:Loc OAuthPassword}" Grid.Row="1" VerticalAlignment="Center" />
                <TextBox x:Name="OAuthPasswordTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0" />
                <Button x:Name="ToggleOAuthButton" Grid.Row="1" Grid.Column="2" Content="{local:Loc Show}" Click="ToggleOAuthButton_Click" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc PublicAccess}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc AccessMode}">
              <StackPanel>
                <RadioButton x:Name="LocalModeRadio" GroupName="TunnelMode" Content="{local:Loc LocalOnly}" Tag="none" Margin="0,4,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc LocalOnlyDescription}" Foreground="{DynamicResource SecondaryText}" Margin="24,-8,0,14" TextWrapping="Wrap" />
                <RadioButton x:Name="QuickModeRadio" GroupName="TunnelMode" Content="{local:Loc TemporaryAddress}" Tag="quick" Margin="0,0,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc TemporaryAddressDescription}" Foreground="{DynamicResource SecondaryText}" Margin="24,-8,0,14" TextWrapping="Wrap" />
                <RadioButton x:Name="NamedModeRadio" GroupName="TunnelMode" Content="{local:Loc CustomDomain}" Tag="named" Margin="0,0,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc CustomDomainDescription}" Foreground="{DynamicResource SecondaryText}" Margin="24,-8,0,4" TextWrapping="Wrap" />
                <RadioButton x:Name="TailscaleModeRadio" GroupName="TunnelMode" Content="Tailscale Funnel" Tag="funnel" Margin="0,12,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc TailscaleDescription}" Foreground="{DynamicResource SecondaryText}" Margin="24,-8,0,4" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>

            <TextBlock x:Name="EffectiveAccessText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="AccessDraftText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12" />
            <GroupBox x:Name="LocalAccessGroup" Header="{local:Loc LocalOnly}" Visibility="Collapsed">
              <TextBox x:Name="LocalAccessAddress" IsReadOnly="True" />
            </GroupBox>
            <GroupBox x:Name="QuickAccessGroup" Header="{local:Loc TemporaryAddress}" Visibility="Collapsed">
              <TextBox x:Name="QuickAccessAddress" IsReadOnly="True" />
            </GroupBox>
            <GroupBox x:Name="NamedTunnelGroup" Header="{local:Loc CustomDomainConfiguration}" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc PublicHTTPSAddress}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="ServerUrlTextBox" TextChanged="NamedDraft_Changed" Grid.Column="1" Margin="0,0,0,10" />
                <TextBlock Text="Tunnel Token" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <PasswordBox x:Name="TunnelTokenPasswordBox" PasswordChanged="NamedDraft_Changed" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" PreviewKeyDown="PasswordBox_PreviewKeyDown" />
                <TextBlock Text="{local:Loc SavedState}" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="TunnelTokenStoredText" Grid.Row="2" Grid.Column="1" Text="{local:Loc TunnelTokenMissing}" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox x:Name="TailscaleGroup" Header="Tailscale Funnel" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{local:Loc TailscaleClient}" Margin="0,5,0,8" />
                  <TextBlock x:Name="TailscaleClientText" Grid.Column="1" Text="{local:Loc NotChecked}" TextWrapping="Wrap" Margin="0,5,0,8" />
                  <TextBlock Text="{local:Loc Status}" Grid.Row="1" Margin="0,0,0,8" />
                  <TextBlock x:Name="TailscaleConnectionText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                  <TextBlock Text="{local:Loc TailscaleDevice}" Grid.Row="2" Margin="0,0,0,8" />
                  <TextBlock x:Name="TailscaleDeviceText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                  <TextBlock Text="{local:Loc TailscaleDomain}" Grid.Row="3" Margin="0,5,0,8" />
                  <TextBox x:Name="TailscaleDomainTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8" />
                  <TextBlock Text="Funnel" Grid.Row="4" Margin="0,0,0,8" />
                  <TextBlock x:Name="TailscaleFunnelText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
                  <TextBlock Text="{local:Loc TailscaleKeyExpiry}" Grid.Row="5" Margin="0,0,0,8" />
                  <TextBlock x:Name="TailscaleKeyExpiryText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
                  <TextBlock Text="{local:Loc TailscaleLocalTarget}" Grid.Row="6" Margin="0,0,0,8" />
                  <TextBlock x:Name="TailscaleTargetText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
                  <TextBlock Text="{local:Loc PublicMCP}" Grid.Row="7" Margin="0,5,0,8" />
                  <TextBox x:Name="TailscaleMcpTextBox" Grid.Row="7" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8" />
                </Grid>
                <TextBlock x:Name="TailscaleDiagnosticText" TextWrapping="Wrap" Margin="0,4,0,10" />
                <WrapPanel>
                  <Button x:Name="TailscaleDetectButton" Content="{local:Loc TailscaleDetect}" Click="TailscaleDetectButton_Click" />
                  <Button x:Name="TailscaleStopButton" Content="{local:Loc TailscaleStop}" Click="TailscaleStopButton_Click" />
                  <Button x:Name="TailscaleAuthorizeButton" Content="{local:Loc TailscaleAuthorize}" Click="TailscaleAuthorizeButton_Click" />
                </WrapPanel>
              </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="ApplyAccessButton" Content="{local:Loc ApplyAccessMode}" Click="ApplyTunnelModeButton_Click" />
              <Button x:Name="RegenerateQuickButton" Content="{local:Loc RegenerateTemporaryAddress}" Click="RegenerateQuickButton_Click" />
            </StackPanel>
            <TextBlock x:Name="TunnelActionStatusText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc Capabilities}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <TextBlock Text="{local:Loc CapabilitiesDescription}"
                       Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{local:Loc RefreshCapabilities}" Click="RefreshCapabilitiesButton_Click" />
            </StackPanel>
            <TextBlock x:Name="CapabilityStatusText"
                       Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       MinHeight="22"
                       Margin="0,0,0,8" />

            <GroupBox Header="{local:Loc Plugins}">
              <StackPanel x:Name="PluginListPanel" />
            </GroupBox>

            <GroupBox Header="{local:Loc StandaloneSkills}">
              <StackPanel x:Name="StandaloneSkillListPanel" />
            </GroupBox>

            <GroupBox Header="{local:Loc StandaloneMcpServers}">
              <StackPanel x:Name="StandaloneMcpListPanel" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc RuntimeConfiguration}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="RuntimeOptionsPanel" Margin="18" Loaded="RuntimeOptionsPanel_Loaded">
            <TextBlock Text="{local:Loc RuntimeConfigurationHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,14" />
            <GroupBox Header="{local:Loc WorkspaceAndInstructions}">
              <StackPanel>
                <TextBlock Text="{local:Loc DefaultGlobalWorkspace}" Margin="0,0,0,5" />
                <DockPanel Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Content="{local:Loc Browse}" Margin="8,0,0,0" Click="DefaultWorkspaceBrowse_Click" />
                  <TextBox x:Name="DefaultWorkspaceTextBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <CheckBox x:Name="AgentsAutoLoadCheckBox" Content="{local:Loc AutoLoadAgentsRules}" Margin="0,0,0,12" />
                <TextBlock Text="{local:Loc ExtraInstructionsFile}" Margin="0,0,0,5" />
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Content="{local:Loc Browse}" Tag="instructions" Margin="8,0,0,0" Click="RuntimeFileBrowse_Click" />
                  <TextBox x:Name="ExtraInstructionsTextBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{local:Loc ExtraInstructionsHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="{local:Loc ProcessAndNetwork}">
              <StackPanel>
                <TextBlock Text="{local:Loc BrowserExecutable}" Margin="0,0,0,5" />
                <DockPanel Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Content="{local:Loc Browse}" Tag="browser" Margin="8,0,0,0" Click="RuntimeFileBrowse_Click" />
                  <TextBox x:Name="BrowserExecutableTextBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{local:Loc TrustedProxyNetworks}" Margin="0,0,0,5" />
                <TextBox x:Name="TrustedProxyTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" Margin="0,0,0,6" />
                <TextBlock Text="{local:Loc TrustedProxyNetworksHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12" />
                <TextBlock Text="{local:Loc CommandEnvironmentReferences}" Margin="0,0,0,5" />
                <TextBox x:Name="CommandEnvReferencesTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Margin="0,0,0,6" />
                <TextBlock Text="{local:Loc CommandEnvironmentHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12" />
                <TextBlock Text="{local:Loc AcpConcurrency}" Margin="0,0,0,5" />
                <TextBox x:Name="AcpConcurrencyTextBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <TextBlock Text="{local:Loc AcpInteractionTimeout}" Margin="0,0,0,5" />
                <TextBox x:Name="AcpTimeoutTextBox" Width="180" HorizontalAlignment="Left" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="{local:Loc ConfigurationLocations}">
              <StackPanel>
                <TextBlock Text="{local:Loc AgentDockDataDirectory}" Margin="0,0,0,5" />
                <TextBox x:Name="AgentDockHomeTextBox" IsReadOnly="True" Margin="0,0,0,12" />
                <TextBlock Text="{local:Loc ConfigurationFiles}" Margin="0,0,0,5" />
                <TextBox x:Name="RuntimeConfigurationPathsTextBox" IsReadOnly="True" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <TextBlock x:Name="RuntimeOptionsStatusText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" MinHeight="22" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SaveRuntimeOptionsButton" Content="{local:Loc SaveAndRestart}" Click="SaveRuntimeOptions_Click" />
              <Button x:Name="ReloadRuntimeOptionsButton" Content="{local:Loc ReloadConfiguration}" Click="ReloadRuntimeOptions_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="显示">
        <StackPanel Margin="18" Loaded="DisplaySettings_Loaded" Unloaded="DisplaySettings_Unloaded">
          <GroupBox Header="主题">
            <StackPanel>
              <ComboBox x:Name="ThemePreferenceCombo" Width="180" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="ThemePreference_Changed">
                <ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/>
              </ComboBox>
              <TextBlock x:Name="ThemeSaveStatus" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="ChatGPT 内嵌界面">
            <StackPanel>
              <CheckBox x:Name="McpUiEnabledChoice" Content="提供 AgentDock 内嵌界面" Click="McpUiPreference_Click" IsEnabled="False"/>
              <TextBlock Text="关闭后仍可调用工具、管理任务和读写文件。此设置不影响其他插件和已经渲染的历史卡片。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock x:Name="McpUiSaveStatus" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="{local:Loc AdvancedSettings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc BasicSettings}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="McpAppsEnabledCheckBox" Grid.Row="0" Grid.ColumnSpan="2" Content="{local:Loc EnableMcpAppsUi}" Margin="0,4,0,12" Visibility="Collapsed" />
                <TextBlock Text="{local:Loc Port}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc LogLevel}" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox x:Name="LogLevelComboBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10">
                  <ComboBoxItem Content="debug" />
                  <ComboBoxItem Content="info" />
                  <ComboBoxItem Content="warn" />
                  <ComboBoxItem Content="error" />
                </ComboBox>
                <TextBlock Text="{local:Loc InterfaceLanguage}" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,4" />
                <ComboBox x:Name="LanguageComboBox" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,4" SelectionChanged="LanguageComboBox_SelectionChanged">
                  <ComboBoxItem Content="{local:Loc FollowSystem}" Tag="system" />
                  <ComboBoxItem Content="{local:Loc SimplifiedChinese}" Tag="zh-CN" />
                  <ComboBoxItem Content="{local:Loc EnglishLanguage}" Tag="en" />
                </ComboBox>
              </Grid>
            </GroupBox>

            <GroupBox Header="Nexus">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Address}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="NexusEndpointTextBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" ToolTip="{local:Loc NexusPublicHttpsTooltip}" />
                <TextBlock Text="{local:Loc OneTimePairingCode}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <PasswordBox x:Name="NexusPairingCodePasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" PreviewKeyDown="PasswordBox_PreviewKeyDown" />
                <Button Grid.Row="1" Grid.Column="2" Content="{local:Loc PairAndRestart}" Click="PairNexusButton_Click" Margin="0,0,0,10" />
                <TextBlock Text="Device Token" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="NexusDeviceTokenStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{local:Loc NotPaired}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc Browser}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="BrowserEnabledCheckBox" Grid.ColumnSpan="2" Content="{local:Loc EnableBrowserCdp}" Margin="0,4,0,12" Checked="BrowserConnection_Changed" Unchecked="BrowserConnection_Changed" />
                <TextBlock Text="{local:Loc ConnectionMode}" Grid.Row="1" VerticalAlignment="Top" Margin="0,5,0,10" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                  <ComboBox x:Name="BrowserConnectionModeComboBox" Width="320" HorizontalAlignment="Left" SelectionChanged="BrowserConnection_Changed">
                    <ComboBoxItem Content="{local:Loc ManagedBrowser}" Tag="managed" />
                    <ComboBoxItem Content="{local:Loc ReuseExistingCdpBrowser}" Tag="reuse" />
                    <ComboBoxItem Content="{local:Loc SpecifiedCdpBrowser}" Tag="specified" />
                  </ComboBox>
                  <TextBox x:Name="BrowserCdpUrlTextBox" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="{local:Loc CdpUrlExample}" />
                  <TextBlock x:Name="BrowserConnectionHelpText" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc CodingAgentAcp}">
              <StackPanel>
                <CheckBox x:Name="AcpEnabledCheckBox" Content="{local:Loc EnableCodingAgent}" Margin="0,4,0,14" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{local:Loc DefaultAcp}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox x:Name="AcpDefaultProfileComboBox"
                            Grid.Column="1"
                            Width="240"
                            SelectionChanged="AcpDefaultProfile_SelectionChanged" />
                </Grid>
                <StackPanel x:Name="AcpProfileListPanel" />
                <Button x:Name="AcpAddCustomProfileButton"
                        Content="{local:Loc AddCustomAcp}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="10,4"
                        Click="AcpAddCustomProfile_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{local:Loc RuntimePermissions}">
              <StackPanel>
                <CheckBox x:Name="ElevatedCoreCheckBox"
                          Content="{local:Loc RunCoreElevated}"
                          Margin="0,4,0,8"
                          Click="ElevatedCoreCheckBox_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{local:Loc Startup}">
              <StackPanel>
                <CheckBox x:Name="CoreStartupCheckBox" Content="{local:Loc CoreStartup}" Margin="0,4,0,10" Click="CoreStartupCheckBox_Click" />
                <CheckBox x:Name="TrayStartupCheckBox" Content="{local:Loc TrayStartup}" Margin="0,0,0,4" Click="TrayStartupCheckBox_Click" />
              </StackPanel>
            </GroupBox>

            <TextBlock x:Name="SettingsStatusText"
                       Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       MinHeight="22"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{local:Loc SaveAndRestart}" Click="SaveSettingsButton_Click" />
              <Button Content="{local:Loc OpenLogsFolder}" Click="OpenLogsButton_Click" />
              <Button Content="{local:Loc OpenConfigFolder}" Click="OpenConfigButton_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid>
        <TextBlock x:Name="FooterStatusText" Text="{local:Loc Ready}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
        <Button Content="{local:Loc Refresh}" HorizontalAlignment="Right" Margin="0" Click="RefreshButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
