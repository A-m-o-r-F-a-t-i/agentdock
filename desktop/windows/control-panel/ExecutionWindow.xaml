<Window x:Class="AgentDock.ControlPanel.ExecutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentDock" Width="1280" Height="800" MinWidth="800" MinHeight="540"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}"
        Loaded="Window_Loaded" Closed="Window_Closed" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
      <Style x:Key="RowMore" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Opacity" Value="1"/><Setter Property="Width" Value="28"/><Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
          <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="CallRowTemplate">
        <Grid Height="{StaticResource ExecutionRowHeight}" Margin="6,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusGlyph}" ToolTip="{Binding State}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
              <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding NeedsApproval}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActualTool}" VerticalAlignment="Center" Margin="7,0,14,0"/>
          <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="3" Width="78" Text="{Binding When}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Visibility="{Binding ShowTimestamps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DetailedCallRowTemplate">
        <Grid Height="{StaticResource ExecutionRowHeight}" Margin="6,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="56"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ActualTool}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Started}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding State}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding Duration}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding ExecutionDuration}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="5" Text="{Binding WaitDuration}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="6" Text="{Binding SourceType}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceType}" VerticalAlignment="Center"/>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="200" MaxWidth="320"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" Padding="12,12,10,12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="搜索工作区或对话" AutomationProperties.Name="搜索工作区或对话" Background="Transparent"/>
            <TextBlock Text="搜索" Foreground="{DynamicResource SecondaryText}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" Content="···" Padding="0" Click="SidebarMenu_Click" ToolTip="对话管理" AutomationProperties.Name="对话管理"/>
        </Grid>
        <Button x:Name="MoreObjectsButton" DockPanel.Dock="Bottom" Content="更多对话" Click="MoreObjects_Click" Visibility="Collapsed"/>
        <Grid>
          <ListBox x:Name="ObjectsList" ItemsSource="{Binding Objects}" SelectionMode="Extended" SelectionChanged="Objects_Changed" PreviewMouseRightButtonDown="Objects_RightClick"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" Loaded="WorkspaceGroup_Loaded" Expanded="WorkspaceGroup_Expanded" Collapsed="WorkspaceGroup_Collapsed" Margin="0,0,0,8">
                      <Expander.Template><ControlTemplate TargetType="Expander">
                        <StackPanel>
                          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Height="34">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                              <Border Background="Transparent" Padding="3,0,6,0"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Arrow" Text="▸" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name.Title}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ItemCount}" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                              </Grid></Border>
                              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                          </ToggleButton>
                          <ContentPresenter x:Name="GroupItems" ContentSource="Content" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                      </ControlTemplate></Expander.Template>
                      <ItemsPresenter/>
                    </Expander>
                  </ControlTemplate></Setter.Value></Setter></Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Height="34" Margin="8,0,3,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SemanticBadge}" Margin="0,0,6,0"><TextBlock Text="对话" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/></Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                <TextBlock Grid.Column="2" Text="{Binding PendingCount}" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PendingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="3" Text="···" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="最近 30 秒有工具调用" AutomationProperties.Name="最近 30 秒有工具调用" Visibility="{Binding RecentlyActive, Converter={StaticResource BoolVisibility}}"/>
                <Button Grid.Column="4" Content="⋮" Style="{StaticResource RowMore}" Click="ObjectMore_Click" ToolTip="管理此对话" AutomationProperties.Name="管理此对话"/>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SidebarEmpty" Text="暂无对话" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}"/>
    <Grid Grid.Column="2" Background="{DynamicResource PanelBackground}">
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="ConversationHeader" Margin="20,0,16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ObjectTitle" Text="选择对话" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AttentionButton" Content="待处理" Visibility="Collapsed" Click="Attention_Click" FontSize="12"/>
          <Button Content="权限" Click="Permissions_Click" FontSize="12"/>
          <Button x:Name="ConnectionButton" Content="连接" Click="Connection_Click" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
          <Button Content="主题" Click="Theme_Click" FontSize="12"/>
          <Button Content="设置" Click="SettingsMenu_Click" FontSize="12"/>
          <Button x:Name="StopConversationButton" Content="停止" Click="Terminate_Click" Style="{StaticResource DangerButton}" Visibility="Collapsed" Margin="8,0,0,0" FontSize="12"/>
          <Button Content="···" Click="ConversationMenu_Click" Width="30" Padding="0" Margin="2,0,0,0" ToolTip="当前对话操作" AutomationProperties.Name="当前对话操作"/>
        </StackPanel>
      </Grid>
      <Border x:Name="WarningPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SelectionBackground}" Margin="20,0,20,8" Padding="10,5" CornerRadius="5">
        <DockPanel><Button DockPanel.Dock="Right" Content="关闭" FontSize="12" Click="DismissWarning_Click"/><TextBlock x:Name="WarningText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </Border>
      <Border x:Name="ConversationProgressCard" Grid.Row="2" Visibility="Collapsed" Margin="20,0,20,8">
        <Grid Height="36">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource SemanticBadge}" Margin="0,0,8,0"><TextBlock Text="任务" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/></Border>
          <Grid Grid.Column="1"><ComboBox x:Name="TaskChoiceCombo" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="TaskChoice_Changed" ToolTip="当前对话的关联任务" Margin="0,0,8,0"/><StackPanel x:Name="NoTaskPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="未关联任务" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><Button Content="关联" Click="LinkTask_Click" Margin="8,0" FontSize="12"/></StackPanel></Grid>
          <TextBlock x:Name="CurrentTaskStatus" Grid.Column="2" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
          <ProgressBar x:Name="CurrentTaskProgress" Grid.Column="3" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="CurrentTaskNext" Grid.Column="4" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
          <StackPanel x:Name="TaskActionsPanel" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FilterTaskButton" Content="筛选此任务" Click="FilterTask_Click" FontSize="12"/><Button Content="任务详情" Click="TaskDetails_Click" FontSize="12"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="20,0,20,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="150"><TextBox x:Name="CallSearchBox" TextChanged="CallSearch_Changed" AutomationProperties.Name="搜索执行记录"/><TextBlock Text="搜索执行记录" Foreground="{DynamicResource SecondaryText}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CallSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <ComboBox x:Name="CallStatusCombo" Width="92" Margin="8,0,0,0" SelectionChanged="CallFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="全部状态" Tag=""/><ComboBoxItem Content="运行中" Tag="running"/><ComboBoxItem Content="待审批" Tag="pending_approval"/><ComboBoxItem Content="失败" Tag="failed"/><ComboBoxItem Content="待核对" Tag="unknown"/></ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="CompactCallsChoice" Content="简洁" GroupName="CallPresentation" Tag="compact" Style="{StaticResource SegmentChoice}" Checked="CallPresentation_Changed" Margin="0,0,3,0"/>
          <RadioButton x:Name="DetailedCallsChoice" Content="详细" GroupName="CallPresentation" Tag="detailed" Style="{StaticResource SegmentChoice}" Checked="CallPresentation_Changed" Margin="0,0,6,0"/>
          <Button x:Name="OlderCallsButton" Content="更早" Click="OlderCalls_Click" IsEnabled="False" FontSize="12"/>
          <Button x:Name="FollowButton" Content="跟随" Click="Follow_Click" FontSize="12" ToolTip="跟随最新调用"/>
          <Button Content="···" Width="30" Padding="0" Click="CallMenu_Click" ToolTip="记录管理" AutomationProperties.Name="记录管理"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="4" Margin="14,0,14,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="DetailedCallsHeader" Height="26" Margin="6,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="56"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="工具" Style="{StaticResource MutedText}" Margin="8,0"/><TextBlock Grid.Column="1" Text="开始" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="状态" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="3" Text="RPC 总计" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="4" Text="执行" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="5" Text="等待" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="6" Text="来源" Style="{StaticResource MutedText}"/>
        </Grid>
        <ListBox x:Name="CallsList" Grid.Row="1" ItemsSource="{Binding Calls}" ItemTemplate="{StaticResource CallRowTemplate}" SelectionMode="Extended"
                 SelectionChanged="Calls_Changed" PreviewMouseRightButtonDown="Calls_RightClick" PreviewMouseWheel="Calls_Wheel" ScrollViewer.ScrollChanged="Calls_ScrollChanged"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="{StaticResource ExecutionRowHeight}"/></Style></ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="EmptyText" Text="暂无执行记录" Foreground="{DynamicResource SecondaryText}"/><Button Content="刷新" Click="Refresh_Click" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <Border x:Name="DetailsPanel" Grid.Row="6" Height="270" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="18,5,18,12">
        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.08"/></Border.Effect>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="关闭" Click="CloseDetails_Click" FontSize="12"/><TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
          <Grid>
            <TabControl x:Name="CallDetailsTabs" SelectionChanged="DetailTab_Changed" Visibility="Collapsed">
              <TabItem Header="命令与输出"><DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,3,0,5"><Button Content="复制命令" Click="CopyCommand_Click" FontSize="12"/><Button Content="复制输出" Click="CopyOutput_Click" FontSize="12"/><Button Content="停止调用" Click="StopCall_Click" IsEnabled="{Binding CanStop}" FontSize="12"/><Button Content="审批" Click="Approve_Click" Visibility="{Binding NeedsApproval, Converter={StaticResource BoolVisibility}}" FontSize="12"/><Button Content="拒绝" Click="Reject_Click" Visibility="{Binding NeedsApproval, Converter={StaticResource BoolVisibility}}" FontSize="12"/><Button Content="重试说明" Click="RetryInstruction_Click" IsEnabled="{Binding CanRetry}" FontSize="12"/></StackPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="64" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0" Padding="4,0"/>
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="4,6"/>
              </DockPanel></TabItem>
              <TabItem Header="来源"><TextBox x:Name="SourceDetailsText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
              <TabItem Header="子调用"><ListBox x:Name="ChildrenList" ItemsSource="{Binding Children}" ItemTemplate="{StaticResource CallRowTemplate}" SelectionChanged="ChildCall_Changed"/></TabItem>
              <TabItem Header="技术"><TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
              <TabItem Header="耗时"><TextBox Text="{Binding TimingDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
              <TabItem Header="文件编辑"><TextBox Text="{Binding FileEditDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" FontFamily="Consolas"/></TabItem>
            </TabControl>
            <DockPanel x:Name="TaskDetailsPanel" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><ComboBox x:Name="BranchCombo" Width="170" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="Branch_Changed"/><Button Content="从此分支继续" Click="ContinueBranch_Click" FontSize="12"/><Button Content="复制继续说明" Click="ContinueTask_Click" FontSize="12"/><Button Content="管理任务" Click="TaskMenu_Click" FontSize="12"/></StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="TaskGoalText" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="TaskStepsText" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="TaskAcceptanceText" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="MilestonesText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/></StackPanel></ScrollViewer>
            </DockPanel>
            <TextBox x:Name="InfoDetailsText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Visibility="Collapsed"/>
            <DockPanel x:Name="DataManagementPanel" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><ComboBox x:Name="DataKindCombo" Width="130" SelectionChanged="DataFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="历史任务" Tag="task"/><ComboBoxItem Content="未归属调用" Tag="unattributed"/><ComboBoxItem Content="全部调用" Tag="call"/></ComboBox><ComboBox x:Name="DataViewCombo" Width="100" Margin="8,0" SelectionChanged="DataFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="当前" Tag="active"/><ComboBoxItem Content="已归档" Tag="archived"/><ComboBoxItem Content="已隔离" Tag="isolated"/><ComboBoxItem Content="回收站" Tag="trash"/></ComboBox><Button Content="管理所选" Click="ManageData_Click" FontSize="12"/><Button Content="导出" Click="ExportData_Click" FontSize="12"/><Button x:Name="MoreDataButton" Content="更多" Click="MoreData_Click" FontSize="12" Visibility="Collapsed"/></StackPanel>
              <ListBox x:Name="ManagedObjectsList" SelectionMode="Extended" PreviewMouseRightButtonDown="Data_RightClick"><ListBox.ItemTemplate><DataTemplate><Grid Height="34" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
